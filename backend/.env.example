PORT=3000
FRONTEND_URL=http://localhost:5173
# Optional comma-separated extra browser origins allowed to call Holdfast.
TRUSTED_ORIGINS=
# Set only when the host runs Holdfast behind known reverse-proxy hops.
# A value of 1 means one trusted proxy hop.
TRUST_PROXY=
# Optional in development. Required in production; point at a persistent
# directory. Holdfast stores holdfast.sqlite and its SQLite sidecar files here.
GUILD_DATA_DIR=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
# Optional provisioning overrides. Defaults live under GUILD_DATA_DIR.
DISCORD_MANIFEST_FILE=
DISCORD_PROVISION_STATE_FILE=
DISCORD_PROVISION_AUDIT_FILE=
DISCORD_PROVISION_REPORT_FILE=
DISCORD_PROVISION_LOCK_FILE=
DISCORD_EXPORT_FILE=
# Archived resources must be at least this old before prune can delete them.
DISCORD_PRUNE_MIN_AGE_DAYS=7
# Optional. When set, newly joined Discord members receive this role.
DISCORD_RECRUIT_ROLE_ID=
# Between 60 and 2592000 seconds. Defaults to 30 days.
DISCORD_SESSION_REVERIFY_SECONDS=2592000
# Production requires at least 32 bytes of random secret material.
SESSION_SECRET=
# Development-only local identity sandbox. Never enable this in production.
# Set true, run npm run dev:seed, then use /api/dev/login/{member|officer|commander}.
HOLDFAST_DEV_AUTH=false
GUILD_OWNER_DISCORD_IDS=
DISCORD_SITE_ADMIN_ROLE_IDS=
DISCORD_QUEST_EDITOR_ROLE_IDS=
DISCORD_REWARD_POLICY_ROLE_IDS=
# Required by npm run backup. Use storage outside GUILD_DATA_DIR.
BACKUP_DIR=
BACKUP_OFFSITE_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=
