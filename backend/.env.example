PORT=3000
FRONTEND_URL=http://localhost:5173
# Optional comma-separated extra browser origins allowed to call Holdfast.
TRUSTED_ORIGINS=
# Set only when the host runs Holdfast behind known reverse-proxy hops.
# A value of 1 means one trusted proxy hop.
TRUST_PROXY=
# Optional in development. Required in production; point at a persistent
# directory. Holdfast stores holdfast.sqlite and its SQLite sidecar files here.
GUILD_DATA_DIR=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
# Optional Discord server template link (https://discord.new/<code>) offered to
# guilds registering on Guildweaver without a Discord server.
GUILDWEAVER_DISCORD_TEMPLATE_URL=
# Optional provisioning overrides. Defaults live under GUILD_DATA_DIR.
DISCORD_MANIFEST_FILE=
DISCORD_PROVISION_STATE_FILE=
DISCORD_PROVISION_AUDIT_FILE=
DISCORD_PROVISION_REPORT_FILE=
DISCORD_PROVISION_LOCK_FILE=
DISCORD_EXPORT_FILE=
# Archived resources must be at least this old before prune can delete them.
DISCORD_PRUNE_MIN_AGE_DAYS=7
# Optional. When set, newly joined Discord members receive this role.
DISCORD_RECRUIT_ROLE_ID=
# Between 60 and 2592000 seconds. Defaults to 30 days.
DISCORD_SESSION_REVERIFY_SECONDS=2592000
# Production requires at least 32 bytes of random secret material.
SESSION_SECRET=
# Development-only local identity sandbox. Never enable this in production.
# Set true, run npm run dev:seed, then use /api/dev/login/{member|officer|commander}.
HOLDFAST_DEV_AUTH=false
GUILD_OWNER_DISCORD_IDS=
# Guild directory, registration and guild pages (including Holdfast's own site).
# Off by default: Guildweaver is a solo, personal product for now. Set true to
# bring the guild surfaces back; their data is kept either way.
GUILDWEAVER_GUILD_FEATURES=false
DISCORD_SITE_ADMIN_ROLE_IDS=
DISCORD_QUEST_EDITOR_ROLE_IDS=
DISCORD_REWARD_POLICY_ROLE_IDS=
# Optional Blizzard Game Data provider. When credentials are omitted, Holdfast
# continues using Guildweaver telemetry metadata and makes no Blizzard requests.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us
BLIZZARD_LOCALE=en_US
# Namespace fallback order. Classic Era is preferred, then Classic progression.
# Add other namespaces explicitly only when you intend to mix game datasets.
BLIZZARD_STATIC_NAMESPACES=static-classic1x-us,static-classic-us
# Provider safety/cache tuning. Defaults are usually appropriate.
BLIZZARD_GAME_DATA_MAX_PER_REQUEST=24
BLIZZARD_GAME_DATA_CONCURRENCY=4
BLIZZARD_GAME_DATA_TIMEOUT_MS=8000
BLIZZARD_GAME_DATA_REFRESH_MS=2592000000
BLIZZARD_GAME_DATA_FAILURE_TTL_MS=3600000

# Auction House prices from Blizzard's WoW Forever auction API (uses the
# BLIZZARD_CLIENT_ID/SECRET above; off without them). One house is read per
# minute at most; houses nobody uses refresh at a quarter of the rate.
MARKET_BLIZZARD_ENABLED=true
MARKET_BLIZZARD_REGIONS=us
# MARKET_BLIZZARD_NAMESPACE=dynamic-forever-{region}
# MARKET_BLIZZARD_RULESET=        # default: the lowest ruleset id (all rulesets list the same houses today)
# MARKET_RULESET_SCOPED=false     # true keeps markets apart per ruleset if Blizzard starts separating them
MARKET_BLIZZARD_REFRESH_MINUTES=60
MARKET_BLIZZARD_MAX_REQUESTS_PER_HOUR=300
# History retention (see docs/AUCTION_HOUSE.md). Weekly history is kept 10 years.
# MARKET_HOURLY_RETENTION_DAYS=10
# MARKET_DAILY_RETENTION_DAYS=400
# Optional copies of item icons in S3-compatible object storage (R2, S3, B2).
# Without them, icons come from Blizzard's media each time they are shown.
# The keys need write access to this bucket only.
# ICON_STORAGE_BUCKET=
# ICON_STORAGE_PREFIX=icons/
# ICON_STORAGE_PUBLIC_URL=        # e.g. https://icons.example.com (else served through the website)
# ICON_STORAGE_REGION=auto
# ICON_STORAGE_ENDPOINT=          # e.g. https://<account>.r2.cloudflarestorage.com
# ICON_STORAGE_ACCESS_KEY_ID=
# ICON_STORAGE_SECRET_ACCESS_KEY=
# Guildweaver public download channel: edge, beta, or stable. Defaults to edge.
GUILDWEAVER_RELEASE_CHANNEL=edge
# Required by npm run backup. Use storage outside GUILD_DATA_DIR.
BACKUP_DIR=
BACKUP_OFFSITE_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=
